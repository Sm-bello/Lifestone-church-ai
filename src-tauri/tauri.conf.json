{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Lifestone",
  "version": "1.0.1",
  "identifier": "com.openbezal.lifestone",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "Lifestone",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      },
      {
        "label": "broadcast",
        "title": "Projector - Program",
        "url": "broadcast-output.html",
        "width": 1920,
        "height": 1080,
        "visible": false,
        "resizable": true,
        "decorations": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'unsafe-eval' 'unsafe-inline' http://localhost:5173 https://localhost; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost tauri: data: blob:; media-src 'self' asset: https://asset.localhost tauri: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost 'self' asset: https://asset.localhost tauri: http://localhost:5173 ws://localhost:5173 https://api.github.com https://github.com; worker-src 'self' blob:; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "dmg",
      "app",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../models/whisper/ggml-nigerian.bin",
      "../data/lifestone.db",
      "../models/minilm-onnx/onnx/model.onnx"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "signingIdentity": null,
      "entitlements": null
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://api.github.com/repos/Sm-bello/lifestone-church-ai/releases/latest"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFCOTBFOUU3QjUxODc2M0UKUldRK2RoaTE1K21RcTg2MkU0VlZQYVpmdFVJd0RBOHdSNGFKcnNScmJwN0ZPeXB6SmhmUUEzTE8K"
    }
  }
}
